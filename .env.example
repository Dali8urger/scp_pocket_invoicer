# =============================================================================
# SCP Pocket EA - Environment Variables
# =============================================================================
# Paste each variable into Vercel's Environment Variables panel for production.
# All variables are required for the app to run.
# =============================================================================

# --- DATABASE ---
# Vercel auto-injects this when you create a Postgres database in the Storage tab.
DATABASE_URL="postgres://..."

# --- AUTH ---
# Generate with: openssl rand -base64 32
# Or: https://generate-secret.vercel.app/32
AUTH_SECRET="paste_32_char_random_string_here"

# Set to your deployed URL after first deploy. Local dev: http://localhost:3000
AUTH_URL="http://localhost:3000"

# Required by NextAuth v5
AUTH_TRUST_HOST="true"

# --- ANTHROPIC ---
ANTHROPIC_API_KEY="sk-ant-api03-..."

# --- OPENAI / WHISPER ---
OPENAI_API_KEY="sk-proj-..."

# --- RESEND / EMAIL ---
RESEND_API_KEY="re_..."
RESEND_FROM="SCP Pocket EA <onboarding@resend.dev>"

# --- USERS ---
ADMIN_EMAIL="d8urger@gmail.com"
OPERATOR_EMAIL="shanecollinsplumbing@gmail.com"

# --- VERCEL BLOB ---
# Vercel auto-injects this when you create a Blob store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- CRON / ADMIN SECURITY ---
# Generate the same way as AUTH_SECRET.
CRON_SECRET="paste_32_char_random_string_here"
